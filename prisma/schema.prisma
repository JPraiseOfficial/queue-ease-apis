// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  previewFeatures = ["partialIndexes"]
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id              String    @id @default(uuid())
  name            String    @unique
  email           String    
  phone           String    
  location        String
  availability    String
  openingTime     String?
  closingTime     String?
  orgCode         String    @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  services        Service[]
  staffs          Staff[]
  tickets         Ticket[]
  queueRecords     QueueRecord[]
  liveBookings    LiveQueueBooking[]
  hourlyMetrics   QueueHourlyMetric[]
}

model Service {
  id           String       @id @default(uuid())
  name         String
  description  String
  code         String
  orgId        String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  organization Organization @relation(fields: [orgId], references: [id])
  staffs       Staff[]
  tickets         Ticket[]
  queueRecords     QueueRecord[]
}

model Staff {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String       
  password     String
  role         String
  isVerified   Boolean      @default(false)
  isEmailVerified     Boolean   @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt
  orgId        String
  serviceId    String?
  organization Organization @relation(fields: [orgId], references: [id])
  service      Service?      @relation(fields: [serviceId], references: [id])
  tickets         Ticket[]
}

model Ticket {
  id              String       @id @default(uuid())
  name            String
  phone           String       
  address         String
  orgId           String
  serviceId       String
  source          String
  ticketNo        String
  status          String      @default("pending")
  handledByStaff  String?
  handledAt       DateTime?
  completedAt     DateTime?   
  waitTime        Int?
  timeSpent       Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt
  organization    Organization  @relation(fields: [orgId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  staff           Staff?       @relation(fields: [handledByStaff], references: [id])

  // Partial Index for Pending Tickets
  @@index([orgId, serviceId, createdAt(sort: Asc)], where: raw("status = 'pending'"), map: "idx_org_service_pending_tickets")

  // Partial Index for Ongoing Tickets
  @@index([orgId, serviceId, createdAt(sort: Asc)], where: raw("status = 'ongoing'"), map: "idx_org_service_ongoing_tickets")

  // Partial Index for Answered Tickets
  @@index([orgId, serviceId, createdAt(sort: Desc)], where: raw("status IN ('served', 'no_show')"), map: "idx_org_service_completed_tickets_today")  
}

model QueueRecord {
  id                      String        @id @default(uuid())
  date                    DateTime      @default(now()) @db.Date
  orgId                   String
  serviceId               String
  totalTicketsDisbursed   Int           @default(0)
  noOfTicketsServed       Int           @default(0)
  noOfnoShowTickets       Int           @default(0)
  organization            Organization  @relation(fields: [orgId], references: [id])
  service                 Service       @relation(fields: [serviceId], references: [id])

  @@index([orgId, date])
  @@unique([orgId, serviceId, date])
}


// I am creating the live tracking table to hold real-time ticket generations
model LiveQueueBooking {
  id                  Int          @id @default(autoincrement())
  scanTimestamp       DateTime
  facilityModel       String       // e.g., 'Standard_9to5'
  facilityName        String       // Explicit name for the dashboard
  predictedWaitTime   Int
  bookingSource       String       // e.g., 'WhatsApp', 'Web'
  createdAt           DateTime     @default(now())
  
  // I am linking this booking explicitly to the organization that owns the facility
  orgId               String
  organization        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// I am defining the Single Source of Truth (SSOT) table for the Prophet engine and PowerBI
model QueueHourlyMetric {
  id                       BigInt       @id @default(autoincrement())
  metricTimestamp          DateTime     @db.Timestamptz
  hourlyQueueCount         Int          @default(0)
  facilityModel            String
  facilityName             String
  isOverride               Boolean      @default(false)
  noShowRate               Decimal      @default(0.00) @db.Decimal(5, 2)
  ticketsWhatsapp          Int          @default(0)
  ticketsWeb               Int          @default(0)
  ticketsSms               Int          @default(0)
  ticketsUssd              Int          @default(0)
  avgServiceTimeDesk1      Decimal      @default(0.00) @db.Decimal(5, 2)
  avgServiceTimeDesk2      Decimal      @default(0.00) @db.Decimal(5, 2)
  avgServiceTimeDesk3      Decimal      @default(0.00) @db.Decimal(5, 2)
  
  // I am linking this metric directly to the core organization
  orgId                    String
  organization             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // I am enforcing the strict duplicate prevention rule you defined in SQL
  @@unique([metricTimestamp, facilityName])
  
  // I am building the indexes to ensure dashboard queries process instantly
  @@index([metricTimestamp])
  @@index([facilityModel])
  @@index([facilityName])
}
