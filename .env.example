# Database connection string for Prisma
# Example for PostgreSQL: DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"
DATABASE_URL=""

# Port for the API server to run on
PORT=3000

# Node environment
NODE_ENV=development

# JWT Secret for generating and validating authentication tokens
JWT_SECRET="your-super-secret-and-long-jwt-key"

# URL for the machine learning engine for predictions
# Contact the repository owner for this value.
ML_ENGINE_URL=""

# Base URL for the API server (used for email verification and reset links)
APP_URL="http://localhost:3000"

# Brevo API credentials for sending transactional emails
# Get your API key from: Brevo Dashboard -> Settings -> SMTP & API -> API Keys tab
# Add your server IP to authorised IPs: https://app.brevo.com/security/authorised_ips
BREVO_API_KEY=""

# The verified sender email address from your Brevo account
# Add/verify senders at: Brevo Dashboard -> Senders & IP -> Senders
BREVO_SENDER=""

# Bcrypt salt rounds for hashing passwords
BCRYPT_SALT=10